[
  {
    "$schema": "./client/src/resources/schemas/ui.json",
    "proxybindingid": 5001,
    "hide_in_list_nav": false,
    "hide_in_media": true,
    "digital_audio_support": false,
    "can_scan_media": false,
    "ui_selects_device": true,
    "device_icon": "app_experience_music",
    "branding_icon": "app_experience_music",
    "deviceIcon": "app_experience_music",
    "brandingIcon": "app_experience_music",
    "tabs": [
      {
        "name": "Categories",
        "screenId": "CategoriesScreen",
        "iconId": "categoriesIcon",
        "screenCommand": {
          "name": "GetCategoriesCommand",
          "type": "PROTOCOL"
        }
      },
      {
        "name": "Genres",
        "screenId": "GenresScreen",
        "iconId": "genresIcon",
        "screenCommand": {
          "name": "GetGenresCommand",
          "type": "PROTOCOL"
        }
      },
      {
        "name": "Radio",
        "screenId": "StationsScreen",
        "iconId": "StationsIcon",
        "screenCommand": {
          "name": "GetStationsCommand",
          "type": "PROTOCOL"
        }
      }
    ],
    "screens": [
      {
        "id": "StationsScreen",
        "name": "Stations",
        "type": "ListScreenType",
        "dataCommand": {
          "name": "GetStations",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "screen",
              "type": "DEFAULT",
              "value": "StationsList"
            }
          ]
        },
        "list": {
          "defaultAction": "StartStation",
          "defaultItemAction": "DefaultStationsAction2",
          "actionIds": [
            "StartStation",
            "StartStation2"
          ],
          "titleProperty": "itemTitle",
          "subtitleProperty": "itemSubtitle",
          "imageProperty": "itemImage",
          "lengthProperty": "itemLength",
          "itemDefaultActionProperty": "default_action",
          "itemActionIdsProperty": [],
          "isLink": {
            "property": "isLink",
            "values": [
              "true"
            ]
          },
          "isHeader": {
            "property": "isHeader",
            "values": [
              "false"
            ]
          }
        }
      }
    ],
    "nowPlaying": {
      "actions": [
        "SaveStation",
        "RemoveStation", 
        "ThumbsUp",
        "ThumbsUpCancel",
        "ThumbsDown",
        "ThumbsDownCancel"
      ],
      "actionIdsProperty": "actions_list",
      "list": {
        "itemDefaultActionProperty": "default_action",
        "itemActionIdsProperty": "actions_list",
        "titleProperty": "title",
        "subtitleProperty": "subtitle",
        "imageProperty": "image_list",
        "lengthProperty": "duration",
        "isHeader": {
          "property": "isHeader",
          "values": [
            "true"
          ]
        }
      }
    },
    "actions": [
      {
        "id": "StartStation",
        "name": "StartStation",
        "type": "LIST_BUTTON_ACTION",
        "command": {
          "name": "StartStation",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "screen",
              "type": "DEFAULT",
              "value": "StartStation"
            },
            {
              "name": "key",
              "type": "FIRST_SELECTED",
              "value": "key"
            }
          ]
        }
      }
    ]
  },
  {
    "dashboard": [
      {
        "id": "play",
        "buttonType": "PLAY",
        "name": "Play",
        "iconId": "playIcon",
        "releaseCommand": {
          "name": "Play",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "transport",
              "type": "DEFAULT",
              "value": "Play"
            }
          ]
        }
      }
    ]
  }
] 