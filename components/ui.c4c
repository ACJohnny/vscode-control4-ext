[
  {
    "$schema": "./client/src/resources/schemas/ui.json",
    "proxybindingid": 5001,
    "hide_in_list_nav": false,
    "hide_in_media": true,
    "digital_audio_support": false,
    "can_scan_media": false,
    "ui_selects_device": true,
    "device_icon": "app_experience_music",
    "branding_icon": "app_experience_music",
    "deviceIcon": "app_experience_music",
    "brandingIcon": "app_experience_music",
    "icons": [
      {
        "id": "app_experience_music",
        "icons": [
          {
            "width": 32,
            "height": 32,
            "path": "controller://driver/DRIVER_FILE_NAME/icons/app_experience_music_32.png"
          },
          {
            "width": 64,
            "height": 64,
            "path": "controller://driver/DRIVER_FILE_NAME/icons/app_experience_music_64.png"
          }
        ]
      },
      {
        "id": "categoriesIcon",
        "sizes": [32, 64],
        "template": "controller://driver/DRIVER_FILE_NAME/icons/categories_%size%.png"
      }
    ],
    "tabs": [
      {
        "name": "Categories",
        "screenId": "CategoriesScreen",
        "iconId": "categoriesIcon",
        "screenCommand": {
          "name": "GetCategoriesCommand",
          "type": "PROTOCOL"
        }
      },
      {
        "name": "Genres",
        "screenId": "GenresScreen",
        "iconId": "genresIcon",
        "screenCommand": {
          "name": "GetGenresCommand",
          "type": "PROTOCOL"
        }
      },
      {
        "name": "Radio",
        "screenId": "StationsScreen",
        "iconId": "StationsIcon",
        "screenCommand": {
          "name": "GetStationsCommand",
          "type": "PROTOCOL"
        }
      }
    ],
    "screens": [
      {
        "id": "StationsScreen",
        "name": "Stations",
        "type": "ListScreenType",
        "dataCommand": {
          "name": "GetStations",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "screen",
              "type": "DEFAULT",
              "value": "StationsList"
            }
          ]
        },
        "list": {
          "defaultAction": "StartStation",
          "defaultItemAction": "DefaultStationsAction2",
          "actionIds": [
            "StartStation",
            "StartStation2"
          ],
          "titleProperty": "itemTitle",
          "subtitleProperty": "itemSubtitle",
          "imageProperty": "itemImage",
          "lengthProperty": "itemLength",
          "itemDefaultActionProperty": "default_action",
          "itemActionIdsProperty": [],
          "isLink": {
            "property": "isLink",
            "values": [
              "true"
            ]
          },
          "isHeader": {
            "property": "isHeader",
            "values": [
              "false"
            ]
          }
        }
      }
    ],
    "search": {
      "filters": [
        {
          "id": "Categories",
          "name": "Category-All",
          "screenId": "SearchAll"
        },
        {
          "id": "Artists",
          "name": "Artists",
          "screenId": "SearchAll"
        },
        {
          "id": "Albums",
          "name": "Albums",
          "screenId": "SearchAll"
        },
        {
          "id": "Playlists",
          "name": "Playlists",
          "screenId": "SearchAll"
        },
        {
          "id": "Tracks",
          "name": "Tracks",
          "screenId": "SearchAll"
        },
        {
          "id": "Genres",
          "name": "Genres",
          "screenId": "SearchAll"
        }
      ],
      "history": [
        {
          "dataCommand": {
            "name": "getData",
            "type": "PROTOCOL",
            "params": [
              {
                "name": "name",
                "type": "DEFAULT",
                "value": "getSearchHistory"
              },
              {
                "name": "formatter",
                "type": "DEFAULT",
                "value": "formatSearchHistory"
              }
            ]
          },
          "deleteCommand": {
            "name": "deleteSearchHistory",
            "type": "PROTOCOL",
            "params": [
              {
                "name": "id",
                "type": "FIRST_SELECTED",
                "value": "history_id"
              }
            ]
          },
          "textProperty": "name"
        }
      ]
    },
    "notifications": [
      {
        "id": "connection_lost",
        "iconId": "warning_icon",
        "buttons": [
          {
            "name": "Retry",
            "command": {
              "name": "RetryConnection",
              "type": "PROTOCOL"
            }
          },
          {
            "name": "Settings",
            "screenId": "SettingsScreen",
            "command": {
              "name": "OpenSettings",
              "type": "PROTOCOL"
            }
          }
        ],
        "cancelButton": {
          "name": "Dismiss",
          "command": {
            "name": "DismissNotification",
            "type": "PROTOCOL"
          }
        }
      }
    ],
    "nowPlaying": {
      "actions": [
        "SaveStation",
        "RemoveStation", 
        "ThumbsUp",
        "ThumbsUpCancel",
        "ThumbsDown",
        "ThumbsDownCancel"
      ],
      "actionIdsProperty": "actions_list",
      "list": {
        "itemDefaultActionProperty": "default_action",
        "itemActionIdsProperty": "actions_list",
        "titleProperty": "title",
        "subtitleProperty": "subtitle",
        "imageProperty": "image_list",
        "lengthProperty": "duration",
        "isHeader": {
          "property": "isHeader",
          "values": [
            "true"
          ]
        }
      }
    },
    "actions": [
      {
        "id": "StartStation",
        "name": "StartStation",
        "type": "LIST_BUTTON_ACTION",
        "command": {
          "name": "StartStation",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "screen",
              "type": "DEFAULT",
              "value": "StartStation"
            },
            {
              "name": "key",
              "type": "FIRST_SELECTED",
              "value": "key"
            }
          ]
        }
      },
      {
        "id": "SaveStation",
        "name": "Save Station",
        "iconId": "save_icon",
        "command": {
          "name": "SaveStation",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "station_id",
              "type": "FIRST_SELECTED",
              "value": "id"
            }
          ]
        },
        "filters": [
          {
            "type": "Change",
            "property": "is_saved",
            "name": "Remove Station",
            "iconId": "remove_icon"
          }
        ]
      }
    ],
    "dashboard": [
      {
        "id": "play",
        "buttonType": "PLAY",
        "name": "Play",
        "iconId": "playIcon",
        "releaseCommand": {
          "name": "Play",
          "type": "PROTOCOL",
          "params": [
            {
              "name": "transport",
              "type": "DEFAULT",
              "value": "Play"
            }
          ]
        }
      },
      {
        "id": "pause",
        "buttonType": "PAUSE",
        "releaseCommand": {
          "name": "Pause",
          "type": "PROTOCOL"
        }
      },
      {
        "id": "next",
        "buttonType": "SKIP_FWD",
        "releaseCommand": {
          "name": "Next",
          "type": "PROTOCOL"
        }
      }
    ],
    "favoriteCommand": {
      "name": "jumpToFavorite"
    }
  }
] 