[
  {
    "$schema": "./client/src/resources/schemas/ui.json",
    "proxybindingid": 5001,
    "hide_in_list_nav": false,
    "hide_in_media": true,
    "digital_audio_support": false,
    "can_scan_media": false,
    "ui_selects_device": true,
    "deviceIcon": "zing_logo",
    "brandingIcon": "zing_logo",
    "tabs": [
      {
        "name": "Explore",
        "screenId": "ExploreScreen",
        "iconId": "exploreIcon"
      },  
      {
        "name": "Radio",
        "screenId": "StationsScreen",
        "iconId": "StationsIcon"
      },
      {
        "name": "Settings",
        "screenCommand": {
          "name": "GetSettingsScreen",
          "type": "PROTOCOL"
        },
        "iconId": "settingsIcon"
      }
    ],
    "screens": 
    [      {        "id": "ExploreScreen",
    "name": "Explore",
    "type": "ListScreenType",
    "dataCommand": {
      "name": "GetExploreItems",
      "type": "PROTOCOL",
      "params": [
        {
          "name": "screen",
          "type": "DEFAULT",
          "value": "explore"
        },
        {
          "name": "search",
          "type": "SEARCH"
      },
      {
        "name":"search_filter",
        "type": "SEARCH_FILTER"}
      ]
    },
    "list": {
      "defaultAction": "GetExploreItem",
      "defaultItemAction": "DefaultItemAction",
      "itemDefaultActionProperty": "default_action",
      "actionIds": [],
      "itemActionIdsProperty": "actions_list",
      "titleProperty": "itemTitle",    
      "subtitleProperty": "itemSubtitle",
      "imageProperty": "itemImage",      
      "isLink": {
        "property": "isLink",
        "values": [
          "true"
        ]
      },
      "isHeader": {
        "property": "isHeader",
        "values": [
          "false"
        ]
      }
    }
  },
