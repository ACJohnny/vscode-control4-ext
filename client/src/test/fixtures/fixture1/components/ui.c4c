      {        "id": "LoggedOutScreen",
        "requiresRefresh": true,
        "name": "Settings",
        "type": "SettingsScreenType",
        "dataCommand": {
          "name": "GetLoggedOutSettingsScreen",
          "type": "PROTOCOL"
        },        
        "items": [
          {
            "type": "HeaderTxt", 
            "value": "Settings"
          },
          {
            "type": "Text",                        
            "property": "status",
            "label": "Account Status"
          },
          {
            "type": "TextField",              
            "property": "username",
            "label": "Username"
          },
          {
            "type": "TextField",              
            "property": "password",              
            "label": "Password",
            "isPassword": true
          },
          {
            "type": "Button",
            "name": "Login",            
            "command": {              
              "type": "PROTOCOL",
              "name": "LogInCommand",
              "params": [
                {
                  "name": "username",
                  "type": "FIRST_SELECTED",
                  "value": "username"
                },
                {
                  "name": "password",
                  "type": "FIRST_SELECTED",
                  "value": "password"
                }
              ]
            }             
          },          
          {
            "type": "TextField",              
            "property": "code",              
            "label": "Code"
          },
          {
            "type": "Button",
            "name": "Login With Code",            
            "command": {              
              "type": "PROTOCOL",
              "name": "LogInCommand",
              "params": [
                {
                  "name": "code",
                  "type": "FIRST_SELECTED",
                  "value": "code"
                }
              ]
            }             
          }
        ]          
      },
      {        "id":"LoggedInScreen",
        "name":"Logged In",
        "type":"SettingsScreenType",
        "dataCommand":{
          "name":"GetLoggedInSettingsScreen",
          "type":"PROTOCOL"
        },
        "items":[
          {
            "type":"HeaderTxt",
            "value":"Logged In"
          },
          {
            "type":"Text",
            "property":"status",
            "label":"Account Status"
          },
          {
            "type":"Button",
            "name":"Logout",
